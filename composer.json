{
    "name": "kudashevs/html-obfuscator",
    "description": "A PHP implementation of an HTML code obfuscator.",
    "type": "library",
    "keywords": ["php", "keywords", "obfuscator", "html obfuscator"],
    "license": "MIT",
    "authors": [
        {
            "name": "Sergey Kudashev",
            "email": "kudashevs@gmail.com",
            "homepage": "https://kudashevs.com",
            "role": "developer"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Kudashevs\\HtmlObfuscator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kudashevs\\HtmlObfuscator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage",
        "test-coverage": "vendor/bin/phpunit --coverage-html build/coverage",
        "analyze": "phpstan analyze src --no-progress --memory-limit=1024M"
    }
}
